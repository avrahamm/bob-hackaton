# IBM i connection — copy this file to .env and fill in real values.
# .env is git-ignored. NEVER commit the real .env file.
#
# To set up:
#   cp api/env.example api/.env
#   edit api/.env

# JT400 JDBC connection
IBMI_HOST=pub400.com
IBMI_USER=YOUR_PUB400_USERNAME
IBMI_PASSWORD=YOUR_PUB400_PASSWORD
IBMI_LIBRARY=ESH101

# Path to jt400.jar (relative to api/ directory, or absolute path)
# Download from: https://github.com/IBM/JTOpen/releases
# Place at api/lib/jt400.jar  (that path is git-ignored)
JT400_JAR=lib/jt400.jar

# Set to "mock" to serve golden JSON files without IBM i
# Set to "live" to use JT400 JDBC against pub400
DATA_SOURCE=mock
